# Environment variables for Docker Compose development

# Application
PORT=8080
NODE_ENV=development

# База данных: по умолчанию — локальная DynamoDB из compose-сети
# (http://dynamodb-local:8000), реквизиты не нужны. Если нужны внешние
# реквизиты Document API (например, Yandex Cloud), задайте их здесь:
# DOCUMENT_API_ENDPOINT=https://docapi.serverless.yandexcloud.net/ru-central1/<folder-id>/<table-id>
# DOCUMENT_API_REGION=ru-central1
# AWS_ACCESS_KEY_ID=<ключ>
# AWS_SECRET_ACCESS_KEY=<секрет>
USE_DATABASE=true
